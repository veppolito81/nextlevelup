---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
        <nav>
                <h2><a href="/">{SITE_TITLE}</a></h2>
                <div class="internal-links">
                        <HeaderLink href="/">Home</HeaderLink>
                        <HeaderLink href="/blog">Blog</HeaderLink>
                        <HeaderLink href="/about">About</HeaderLink>
                </div>
                <div class="social-links">
                        <a href="https://sim.ai" target="_blank" rel="noreferrer">Cloud</a>
                        <a href="https://docs.sim.ai" target="_blank" rel="noreferrer">Docs</a>
                        <a href="https://discord.gg/Hr4UWYEcTT" target="_blank" rel="noreferrer">Discord</a>
                        <a href="https://github.com/simstudioai/sim" target="_blank" rel="noreferrer">GitHub</a>
                </div>
        </nav>
</header>
<style>
        header {
                margin: 0;
                padding: 0 1em;
                background: white;
                box-shadow: 0 2px 8px rgba(var(--black), 5%);
        }
        h2 {
                margin: 0;
                font-size: 1em;
        }

        h2 a,
        h2 a.active {
                text-decoration: none;
        }
        nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
        }
        nav a {
                padding: 0.75em 0.5em;
                color: var(--black);
                border-bottom: 4px solid transparent;
                text-decoration: none;
                font-weight: 600;
        }
        nav a.active {
                text-decoration: none;
                border-bottom-color: var(--accent);
        }
        .social-links {
                display: flex;
                gap: 0.5rem;
        }
        .social-links a {
                border: 1px solid rgb(var(--gray-light));
                border-radius: 999px;
                padding: 0.4em 0.9em;
                font-size: 0.9em;
                transition: all 0.2s ease;
        }
        .social-links a:hover {
                color: rgb(var(--accent));
                border-color: rgb(var(--accent));
        }
        @media (max-width: 920px) {
                nav {
                        flex-wrap: wrap;
                }
                .social-links {
                        width: 100%;
                        justify-content: flex-start;
                        padding-bottom: 0.5rem;
                        order: 3;
                }
        }
        @media (max-width: 720px) {
                .social-links {
                        display: none;
                }
        }
</style>
